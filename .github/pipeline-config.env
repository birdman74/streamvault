# .github/pipeline-config.env
#
# Every knob of the agentic pipeline lives here, in one versioned file.
# Read and validated by scripts/pipeline-config.sh. The workflows always load
# it from main (never from a feature branch), so a change takes effect for
# every story as soon as it is pushed to main.
#
# Format: KEY=value, one per line. No quotes, no shell syntax: the value is
# everything after the first '='. Lines starting with # are comments.
# See docs/adr/ADR-005-pipeline-core-and-direct-persona-loops.md.

# --- Accounts -------------------------------------------------------------
# Brian: reviews and merges PRs, receives escalations
OWNER_LOGIN=birdman74
# Bot collaborator: opens PRs, posts Test verdicts, creates escalation issues
BOT_LOGIN=briankcampbell-streamvault-bot
# Who needs-brian escalation issues are assigned to
ESCALATION_ASSIGNEE=birdman74
# Git author names the persona containers commit as
PO_GIT_AUTHOR=claude-streamvault-po
DEV_GIT_AUTHOR=claude-streamvault-dev
TEST_GIT_AUTHOR=claude-streamvault-test

# --- Build ----------------------------------------------------------------
# The full-suite command personas run, named in their prompts
VERIFY_COMMAND=mvn clean verify

# --- Persona launchers (paths on the self-hosted runner host) -------------
PO_LAUNCHER=/home/brian/bin/streamvault-po-auto.sh
DEV_LAUNCHER=/home/brian/bin/streamvault-dev-auto.sh
TEST_LAUNCHER=/home/brian/bin/streamvault-test-auto.sh

# --- Round limits (exceeding one escalates to Brian) ----------------------
# Dev design reviews of Test's plan before agreement is required
DESIGN_ROUND_LIMIT=3
# Dev-to-Test reports of defective tests per story (implementation and fix phases)
IMPL_FEEDBACK_ROUND_LIMIT=3
# Test CHANGES_REQUESTED verdicts since Brian's last review on a PR
DEV_FIX_ROUND_LIMIT=3
# Questions Test or Dev may ask PO about one story's acceptance criteria
PO_QUESTION_LIMIT=2

# --- Timing ---------------------------------------------------------------
# Step timeout for one persona run (must be at most 330: the job limit is 360)
PERSONA_TIMEOUT_MINUTES=180
# How often, and how far apart, to look for a persona's result on GitHub
OUTCOME_CHECK_ATTEMPTS=3
OUTCOME_CHECK_INTERVAL_SECONDS=20
# Pause after an issue or label change before reading it back from the API
API_PROPAGATION_WAIT_SECONDS=30

# --- Project board --------------------------------------------------------
PROJECT_TITLE=StreamVault
STATUS_FIELD=Status
COLUMN_DONE=Done
COLUMN_IN_PROGRESS=In Progress
COLUMN_BLOCKED=Backlog
COLUMN_READY=Ready
